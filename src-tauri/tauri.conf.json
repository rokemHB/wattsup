{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WattsUp",
  "version": "0.1.0",
  "identifier": "app.wattsup.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WattsUp",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SportsGame",
    "shortDescription": "Ride real climbs on your smart trainer",
    "longDescription": "Indoor cycling on real roads with gradients from official terrain data. Drives a Zwift Cog and Click without a subscription, and has ERG workouts in a small always-on-top window.",
    "publisher": "WattsUp",
    "copyright": "MIT licensed",
    "license": "MIT",
    "homepage": "https://github.com/rokemHB/wattsup",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": { "depends": ["bluez"] },
      "rpm": { "depends": ["bluez"] }
    }
  }
}
